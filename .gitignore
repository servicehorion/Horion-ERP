# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# build backups & temp debug files
.next_bak*/
auth-cookies.txt
auth-dev.log
auth-stderr.log
auth-stdout.log
build-agent.log
smoke-stderr.log
smoke-stdout.log
tsc-errors.txt
typecheck.out
typecheck-latest.log
prisma-drift.sql
prisma-drift-safe.sql
