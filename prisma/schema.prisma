  @@map("incidents")
}

// ============================================================
// J. WHATSAPP & COMMUNITY
// ============================================================

model Channel {
  id        String   @id @default(cuid())
  tenantId  String
  platform  String
  type      String
  name      String
  link      String?
  category  String?
  status    String   @default("active")
  rules     Json     @default("{}")
  ownerId   String?
