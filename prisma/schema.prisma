  tenantId        String
  name            String
  type            String   @default("INCOMING") // INCOMING | IN_PROCESS | FINAL | AUDIT
  productCategory String?
  description     String?
  checklist       Json     @default("[]") // [{id, criterion, weight, required}]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  inspections QcInspection[]

  @@index([tenantId])
  @@map("qc_plans")
}

model QcInspection {
  id          String    @id @default(cuid())
  tenantId    String
  planId      String
  orderId     String?
  supplierId  String?
  scheduledAt DateTime
  completedAt DateTime?
  inspectedBy String?
  status      String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  overall     String? // PASS | FAIL | CONDITIONAL
  defectRate  Decimal?  @db.Decimal(5, 2)
  sampleSize  Int?
  notes       String?
  attachments Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  plan          QcPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
