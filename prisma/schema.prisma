}

// ============================================================
// L. CATALOG OS (Produits, Fournisseurs, Offres, Preuves)
// ============================================================

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String?
  parentId  String?
  createdAt DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products CatalogProduct[]

  @@unique([tenantId, name])
  @@map("product_categories")
}

model CatalogProduct {
  id                  String        @id @default(cuid())
  tenantId            String
  name                String
  categoryId          String?
  status              ProductStatus @default(TESTING)
  specsJson           Json          @default("{}") // dimensions, matériaux, compatibilités, packaging
  mediaIds            Json          @default("[]")
  weightEstimate      Decimal?      @db.Decimal(10, 2)
  volumeEstimate      Decimal?      @db.Decimal(10, 4)
  qcRecommendedLevel  String?       // VIRTUAL, PRE_SHIPMENT, EXTREME
  demandScore         Int           @default(0)
  moqMin              Int?
  priceMin            Decimal?      @db.Decimal(15, 2)
  priceMax            Decimal?      @db.Decimal(15, 2)
  priceCurrency       String        @default("RMB")
  averageMargin       Decimal?      @db.Decimal(5, 2)
  averageLeadTime     Int?          // en jours
  lastOrderedAt       DateTime?
  shippingHints       Json          @default("{}") // fragile, batteries, restrictions
  marketingPack       Json          @default("{}") // textes, prix indicatif, hook, CTA
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  category         ProductCategory?  @relation(fields: [categoryId], references: [id])
  supplierProducts SupplierProduct[]
  orderItems       OrderItem[]
  offers           Offer[]
  qcReports        QCReport[]
  media            CatalogMedia[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("catalog_products")
}

enum ProductStatus {
  TESTING
  TESTED
  CURATED
  BLACKLIST
}

model SupplierProduct {
  id               String                @id @default(cuid())
  supplierId       String
  productId        String
  moq              Int?
  priceMin         Decimal?              @db.Decimal(15, 2)
  priceMax         Decimal?              @db.Decimal(15, 2)
  currency         String                @default("RMB")
  leadTimeDays     Int?
  reliabilityNotes String?
  status           SupplierProductStatus @default(ACTIVE)
  isPrimary        Boolean               @default(false)
  lastVerifiedAt   DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  supplier Supplier        @relation(fields: [supplierId], references: [id])
  product  CatalogProduct  @relation(fields: [productId], references: [id])
  offers   Offer[]

  @@unique([supplierId, productId])
  @@index([productId])
  @@index([supplierId])
  @@map("supplier_products")
}

enum SupplierProductStatus {
  ACTIVE
  PAUSED
}

model CatalogMedia {
  id               String    @id @default(cuid())
  tenantId         String
  type             String    // image, video, pdf, document
  url              String
  filename         String?
  tags             Json      @default("[]")
  linkedEntityType String    // product, supplier, order, qc_report
  linkedEntityId   String
  productId        String?
  supplierId       String?
  orderId          String?
  createdAt        DateTime  @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  product  CatalogProduct? @relation(fields: [productId], references: [id])
  supplier Supplier?       @relation(fields: [supplierId], references: [id])

  @@index([linkedEntityType, linkedEntityId])
  @@index([productId])
  @@index([supplierId])
  @@index([tenantId])
  @@map("catalog_media")
}

model KnowledgePack {
  id          String   @id @default(cuid())
  tenantId    String
  version     Int      @default(1)
  content     Json     @default("{}") // top suppliers, top products, playbooks, benchmarks
  status      String   @default("draft") // draft, published
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("knowledge_packs")
}

// ============================================================
// M. CUSTOMER INTELLIGENCE (Bloomberg-level CRM)
// ============================================================

model CustomerFinancialMetrics {
  id                    String   @id @default(cuid())
  contactId             String   @unique
  lifetimeGrossRevenue  Decimal  @db.Decimal(15, 2) @default(0)
  lifetimeNetProfit     Decimal  @db.Decimal(15, 2) @default(0)
  averageMarginPercent  Decimal  @db.Decimal(5, 2) @default(0)
  cashAtRisk            Decimal  @db.Decimal(15, 2) @default(0) // money in China/transit/customs
  daysOfCashImmobil     Int      @default(0) // DCI
  customerAcqCost       Decimal? @db.Decimal(15, 2) // CAC
  paybackPeriodDays     Int?
  contributionScore     Decimal  @db.Decimal(5, 2) @default(0) // importance to cashflow (0-100)
  totalOrdersCount      Int      @default(0)
  avgOrderValue         Decimal  @db.Decimal(15, 2) @default(0)
  lastOrderDate         DateTime?
  calculatedAt          DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("customer_financial_metrics")
}

model CustomerRiskProfile {
  id                    String   @id @default(cuid())
  contactId             String   @unique
  globalRiskScore       Int      @default(50) // 0-100
  paymentRisk           Int      @default(50) // 0-100
  logisticsRisk         Int      @default(50)
  customsRisk           Int      @default(50)
  disputeFrequency      Decimal  @db.Decimal(5, 2) @default(0) // disputes per order
  supplierReliability   Decimal  @db.Decimal(5, 2) @default(50)
  countryRegulatoryRisk Int      @default(50)
  cashExposure          Decimal  @db.Decimal(15, 2) @default(0) // Horion money at risk
  riskBadges            Json     @default("[]") // ["LOW_RISK", "CASH_RISK", "SUPPLY_RISK", etc.]
  riskFactors           Json     @default("{}") // detailed risk breakdown
  calculatedAt          DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([globalRiskScore])
  @@map("customer_risk_profiles")
}

model CustomerPipelineIntent {
  id                String    @id @default(cuid())
  contactId         String
  productCategory   String?
  productName       String?
  estimatedOrderDate DateTime?
  estimatedSize     Decimal?  @db.Decimal(15, 2)
  currency          String    @default("XAF")
  probability       Decimal   @db.Decimal(3, 2) @default(0.5) // 0.0-1.0
  expectedRevenue   Decimal   @db.Decimal(15, 2) @default(0) // size * probability
  source            String?   // whatsapp, crm, website, etc.
  notes             String?
  status            String    @default("active") // active, converted, lost
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([contactId, status])
  @@map("customer_pipeline_intents")
}

model CustomerAIProfile {
  id                       String   @id @default(cuid())
  contactId                String   @unique
  buyingPersonality        String?  // price_driven, quality_driven, urgent, seasonal
  negotiationStyle         String?  // aggressive, collaborative, passive
  sensitivityToDelays      String?  // low, medium, high
  priceElasticity          String?  // low, medium, high
  recommendedPricingStrategy String?
  recommendedPaymentTerms  String?
  recommendedLogisticsStrategy String?
  upsellSuggestions        Json     @default("[]")
  crossSellSuggestions     Json     @default("[]")
  behavioralInsights       Json     @default("{}")
  predictedChurnRisk       Decimal? @db.Decimal(3, 2) // 0.0-1.0
  predictedLTV             Decimal? @db.Decimal(15, 2)
  calculatedAt             DateTime @default(now())
  updatedAt                DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("customer_ai_profiles")
}

model CustomerSupplyChain {
  id                   String   @id @default(cuid())
  contactId            String
  supplierId           String
  transitPartnerId     String?
  route                String?  // e.g. "Guangzhou-Pointe-Noire"
  ordersCount          Int      @default(0)
  avgDelayDays         Decimal? @db.Decimal(5, 2)
  qcIssuesCount        Int      @default(0)
  customsIssuesCount   Int      @default(0)
  reliabilityScore     Decimal  @db.Decimal(5, 2) @default(50)
  lastUsedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  transitPartner FreightPartner? @relation(fields: [transitPartnerId], references: [id])

  @@unique([contactId, supplierId])
  @@index([contactId])
  @@index([supplierId])
  @@map("customer_supply_chains")
}

enum CustomerSegment {
  CASHFLOW_DRIVER
  STRATEGIC_GROWTH
  HIGH_RISK_HIGH_REWARD
  LOW_MARGIN_VOLUME
  TEST_CLIENT
  ONE_TIME_BUYER
  KEY_ACCOUNT
  AT_RISK
}

model CustomerSegmentation {
  id        String          @id @default(cuid())
  contactId String
  segment   CustomerSegment
  score     Decimal         @db.Decimal(5, 2) @default(0) // relevance score
  assignedAt DateTime       @default(now())
  notes     String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, segment])
  @@index([contactId])
  @@index([segment])
  @@map("customer_segmentations")
}

// ============================================================
// N. SUPPLIER INTELLIGENCE (Bloomberg-level Sourcing)
// ============================================================

model SupplierFinancialMetrics {
  id                     String    @id @default(cuid())
  supplierId             String    @unique
  totalOrdersCount       Int       @default(0)
  lifetimeSpend          Decimal   @db.Decimal(15, 2) @default(0)
  totalPaymentsOut       Decimal   @db.Decimal(15, 2) @default(0)
  avgOrderValue          Decimal   @db.Decimal(15, 2) @default(0)
  lastOrderDate          DateTime?
  spendConcentration     Decimal   @db.Decimal(5, 2) @default(0)
  supplierDependency     Decimal   @db.Decimal(5, 2) @default(0)
  priceTrendDirection    String?   // INCREASING, DECREASING, STABLE
  priceTrendPercent      Decimal?  @db.Decimal(5, 2)
  savingsRealized        Decimal   @db.Decimal(15, 2) @default(0)
  avgNegotiationDiscount Decimal   @db.Decimal(5, 2) @default(0)
  costEfficiencyScore    Decimal   @db.Decimal(5, 2) @default(50)
  totalCostOfOwnership   Decimal   @db.Decimal(15, 2) @default(0)
  calculatedAt           DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_financial_metrics")
}

model SupplierPerformanceProfile {
  id                    String    @id @default(cuid())
  supplierId            String    @unique
  onTimeDeliveryRate    Decimal   @db.Decimal(5, 2) @default(0)
  avgLeadTimeDays       Decimal?  @db.Decimal(5, 2)
  leadTimeVariance      Decimal?  @db.Decimal(5, 2)
  earlyDeliveryCount    Int       @default(0)
  lateDeliveryCount     Int       @default(0)
  avgDelayDays          Decimal?  @db.Decimal(5, 2)
  qualityScore          Decimal   @db.Decimal(5, 2) @default(50)
  qcPassRate            Decimal   @db.Decimal(5, 2) @default(0)
  defectRate            Decimal   @db.Decimal(5, 2) @default(0)
  qcIssuesCount         Int       @default(0)
  disputeRate           Decimal   @db.Decimal(5, 2) @default(0)
  disputeResolutionDays Decimal?  @db.Decimal(5, 2)
  incidentCount         Int       @default(0)
  responseTimeHours     Decimal?  @db.Decimal(5, 2)
  communicationScore    Decimal   @db.Decimal(5, 2) @default(50)
  reliabilityIndex      Decimal   @db.Decimal(5, 2) @default(50)
  calculatedAt          DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([reliabilityIndex])
  @@map("supplier_performance_profiles")
}

model SupplierRiskProfile {
  id                     String   @id @default(cuid())
  supplierId             String   @unique
  globalRiskScore        Int      @default(50)
  concentrationRisk      Int      @default(50)
  qualityRisk            Int      @default(50)
  deliveryRisk           Int      @default(50)
  financialRisk          Int      @default(50)
  geopoliticalRisk       Int      @default(50)
  complianceRisk         Int      @default(50)
  outstandingOrdersValue Decimal  @db.Decimal(15, 2) @default(0)
  cashAtRisk             Decimal  @db.Decimal(15, 2) @default(0)
  riskBadges             Json     @default("[]")
  riskFactors            Json     @default("{}")
  mitigationActions      Json     @default("[]")
  blacklistHistory       Boolean  @default(false)
  suspensionCount        Int      @default(0)
  lastIncidentDate       DateTime?
  calculatedAt           DateTime @default(now())
  updatedAt              DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([globalRiskScore])
  @@map("supplier_risk_profiles")
}

model SupplierAIProfile {
  id                         String    @id @default(cuid())
  supplierId                 String    @unique
  supplierPersonality        String?   // PRICE_FLEXIBLE, RIGID, QUALITY_FOCUSED, VOLUME_DRIVEN
  negotiationLeverage        String?   // HIGH, MEDIUM, LOW
  responsiveness             String?   // FAST, MEDIUM, SLOW
  strategicValue             String?   // STRATEGIC_PARTNER, COMMODITY, BOTTLENECK, LEVERAGE
  supplierPowerScore         Decimal   @db.Decimal(5, 2) @default(50)
  recommendedStrategy        String?   // CONSOLIDATE, DIVERSIFY, NEGOTIATE, DEVELOP, EXIT
  consolidationOpportunities Json      @default("[]")
  alternativeSuggestions     Json      @default("[]")
  predictedPriceDirection    String?   // UP, DOWN, STABLE
  predictedPriceChange       Decimal?  @db.Decimal(5, 2)
  churnRiskScore             Decimal?  @db.Decimal(3, 2)
  optimalOrderSize           Decimal?  @db.Decimal(15, 2)
  optimalOrderFrequency      String?   // WEEKLY, MONTHLY, QUARTERLY
  estimatedAnnualValue       Decimal?  @db.Decimal(15, 2)
  strengthFactors            Json      @default("[]")
  weaknessFactors            Json      @default("[]")
  behavioralInsights         Json      @default("{}")
  calculatedAt               DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_ai_profiles")
}

enum SupplierSegment {
  STRATEGIC_PARTNER
  LEVERAGE_SUPPLIER
  BOTTLENECK
  ROUTINE
  A_SUPPLIER
  B_SUPPLIER
  C_SUPPLIER
  AT_RISK
  PREFERRED
  DEVELOPING
  EXITING
}

model SupplierSegmentation {
  id         String          @id @default(cuid())
  supplierId String
  segment    SupplierSegment
  score      Decimal         @db.Decimal(5, 2) @default(0)
  assignedAt DateTime        @default(now())
  notes      String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, segment])
  @@index([supplierId])
  @@index([segment])
  @@map("supplier_segmentations")
}
