  items         QcChecklistItem[]
  spcDataPoints QcSpcDataPoint[]

  @@index([tenantId])
  @@index([planId])
  @@index([orderId])
  @@index([supplierId])
  @@map("qc_inspections")
}

model QcChecklistItem {
  id           String  @id @default(cuid())
  inspectionId String
  criterion    String
  result       String? // PASS | FAIL | NA
  notes        String?
  photos       Json    @default("[]")
  defectCount  Int?

  inspection QcInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("qc_checklist_items")
}

