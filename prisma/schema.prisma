  title       String
  description String?
  ownerId     String?
  status      String    @default("ON_TRACK")
  targetDate  DateTime?
  progress    Float     @default(0)
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
