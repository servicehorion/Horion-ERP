// ============================================================
// H. TASK ENGINE (CENTRALISE) â€” Enterprise + AI-Agent Ready
// ============================================================

model Task {
  id                String     @id @default(cuid())
  tenantId          String
  entityType        String
  entityId          String
  taskType          String
  title             String
  description       String?
  status            TaskStatus @default(PENDING)
  priority          Priority   @default(NORMAL)
  ownerType         OwnerType  @default(HUMAN)
  module            String
  slaDeadline       DateTime?
  slaBreach         Boolean    @default(false)
  blockedBy         String?
  requiredApproval  Boolean    @default(false)
  automationAllowed Boolean    @default(false)
  riskLevel         RiskLevel  @default(LOW)
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Subtasks â€” self-relation
  parentTaskId String?
  parent       Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  children     Task[]  @relation("TaskSubtasks")
  position     Int     @default(0) // ordering in lists/kanban

  // Project / Sprint link
  projectId   String?
  sprintId    String?
  storyPoints Int?

  // Template & scheduling
  templateId     String?
  dueDate        DateTime?
  startedAt      DateTime?
  estimatedHours Float?
  actualHours    Float?

  // Tags (simple array)
  tags String[] @default([])

  // Custom fields (flexible JSON for per-module metadata)
  customFields Json? @default("{}")

  // AI Agent fields
  agentId   String? // which agent is executing
  agentName String? // human-readable agent name

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  order           Order?           @relation(fields: [entityId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  sprint          Sprint?          @relation(fields: [sprintId], references: [id])
  assignments     TaskAssignment[]
  approvals       Approval[]
  comments        TaskComment[]
  watchers        TaskWatcher[]
  agentExecutions AgentExecution[]
  attachments     TaskAttachment[]
  timeEntries     TaskTimeEntry[]
  checklists      TaskChecklist[]
  // Dependencies
  dependencies    TaskDependency[] @relation("TaskDependencies")
  dependents      TaskDependency[] @relation("TaskDependents")

  @@index([tenantId, status])
  @@index([tenantId, module])
  @@index([entityType, entityId])
  @@index([slaDeadline])
  @@index([parentTaskId])
  @@index([ownerType, status])
  @@index([projectId])
  @@index([sprintId])
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING_APPROVAL
  BLOCKED
  COMPLETED
  CANCELLED
}

enum OwnerType {
  HUMAN
  AI_AGENT
  SYSTEM
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  role       String   @default("assignee")
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model Approval {
  id        String           @id @default(cuid())
  taskId    String
  userId    String
  decision  ApprovalDecision
  comment   String?
  decidedAt DateTime         @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("approvals")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  ESCALATED
}

// â”€â”€ Task Comments (dedicated model, not AuditLog) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  mentions  String[] @default([]) // user IDs mentioned with @
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id])
  reactions TaskCommentReaction[]

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// â”€â”€ Task Comment Reactions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([commentId, userId, emoji])
  @@map("task_comment_reactions")
}

// â”€â”€ Task Checklists â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskChecklist {
  id        String   @id @default(cuid())
  taskId    String
  text      String
  checked   Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklists")
}

// â”€â”€ Task Attachments â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  name      String
  url       String
  type      String   @default("link") // link, file, image, document
  size      Int? // bytes
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_attachments")
}

// â”€â”€ Task Watchers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskWatcher {
  id     String @id @default(cuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@map("task_watchers")
}

// â”€â”€ Task Dependencies (DAG) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskDependency {
  id          String         @id @default(cuid())
  taskId      String
  dependsOnId String
  type        DependencyType @default(BLOCKS)
  createdAt   DateTime       @default(now())

  task      Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

enum DependencyType {
  BLOCKS // dependsOn must complete before task can start
  REQUIRES // dependsOn must complete before task can complete
  RELATED // informational link
}

// â”€â”€ Task Templates â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskTemplate {
  id                    String    @id @default(cuid())
  tenantId              String
  name                  String
  description           String?
  module                String
  taskType              String
  titleTemplate         String // e.g. "VÃ©rifier QC pour {{orderNumber}}"
  descriptionTemplate   String?
  defaultPriority       Priority  @default(NORMAL)
  defaultSlaHours       Int?
  defaultTags           String[]  @default([])
  requiresApproval      Boolean   @default(false)
  automationAllowed     Boolean   @default(false)
  ownerType             OwnerType @default(HUMAN)
  // Subtask definitions as JSON array: [{title, priority, slaHours, module}]
  subtaskDefinitions    Json      @default("[]")
  // Dependency definitions as JSON: [{fromStep, toStep, type}]
  dependencyDefinitions Json      @default("[]")
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  recurringTask RecurringTask?

  @@index([tenantId, module])
  @@map("task_templates")
}

// â”€â”€ Recurring Tasks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RecurringTask {
  id             String    @id @default(cuid())
  tenantId       String
  templateId     String    @unique
  cronExpression String // e.g. "0 9 * * 1" (Mon 9am)
  timezone       String    @default("Africa/Brazzaville")
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  template TaskTemplate @relation(fields: [templateId], references: [id])

  @@index([isActive, nextRunAt])
  @@map("recurring_tasks")
}

// â”€â”€ AI Agent Execution Log â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AgentExecution {
  id          String               @id @default(cuid())
  taskId      String
  agentId     String // unique agent identifier
  agentName   String // human-readable name
  status      AgentExecutionStatus @default(QUEUED)
  input       Json? // context passed to agent
  output      Json? // result from agent
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([agentId, status])
  @@map("agent_executions")
}

enum AgentExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// â”€â”€ Saved Filters (Named Views) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

