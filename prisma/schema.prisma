  priceTrendPercent      Decimal?  @db.Decimal(5, 2)
  savingsRealized        Decimal   @default(0) @db.Decimal(15, 2)
  avgNegotiationDiscount Decimal   @default(0) @db.Decimal(5, 2)
  costEfficiencyScore    Decimal   @default(50) @db.Decimal(5, 2)
  totalCostOfOwnership   Decimal   @default(0) @db.Decimal(15, 2)
  calculatedAt           DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_financial_metrics")
}

model SupplierPerformanceProfile {
  id                    String   @id @default(cuid())
  supplierId            String   @unique
  onTimeDeliveryRate    Decimal  @default(0) @db.Decimal(5, 2)
  avgLeadTimeDays       Decimal? @db.Decimal(5, 2)
  leadTimeVariance      Decimal? @db.Decimal(5, 2)
  earlyDeliveryCount    Int      @default(0)
  lateDeliveryCount     Int      @default(0)
  avgDelayDays          Decimal? @db.Decimal(5, 2)
  qualityScore          Decimal  @default(50) @db.Decimal(5, 2)
  qcPassRate            Decimal  @default(0) @db.Decimal(5, 2)
  defectRate            Decimal  @default(0) @db.Decimal(5, 2)
  qcIssuesCount         Int      @default(0)
  disputeRate           Decimal  @default(0) @db.Decimal(5, 2)
  disputeResolutionDays Decimal? @db.Decimal(5, 2)
  incidentCount         Int      @default(0)
  responseTimeHours     Decimal? @db.Decimal(5, 2)
  communicationScore    Decimal  @default(50) @db.Decimal(5, 2)
  reliabilityIndex      Decimal  @default(50) @db.Decimal(5, 2)
  calculatedAt          DateTime @default(now())
  updatedAt             DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([reliabilityIndex])
  @@map("supplier_performance_profiles")
}

model SupplierRiskProfile {
  id                     String    @id @default(cuid())
  supplierId             String    @unique
  globalRiskScore        Int       @default(50)
  concentrationRisk      Int       @default(50)
  qualityRisk            Int       @default(50)
  deliveryRisk           Int       @default(50)
  financialRisk          Int       @default(50)
  geopoliticalRisk       Int       @default(50)
  complianceRisk         Int       @default(50)
  outstandingOrdersValue Decimal   @default(0) @db.Decimal(15, 2)
  cashAtRisk             Decimal   @default(0) @db.Decimal(15, 2)
  riskBadges             Json      @default("[]")
  riskFactors            Json      @default("{}")
  mitigationActions      Json      @default("[]")
  blacklistHistory       Boolean   @default(false)
  suspensionCount        Int       @default(0)
  lastIncidentDate       DateTime?
  calculatedAt           DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([globalRiskScore])
  @@map("supplier_risk_profiles")
}

model SupplierAIProfile {
  id                         String   @id @default(cuid())
  supplierId                 String   @unique
  supplierPersonality        String? // PRICE_FLEXIBLE, RIGID, QUALITY_FOCUSED, VOLUME_DRIVEN
  negotiationLeverage        String? // HIGH, MEDIUM, LOW
  responsiveness             String? // FAST, MEDIUM, SLOW
  strategicValue             String? // STRATEGIC_PARTNER, COMMODITY, BOTTLENECK, LEVERAGE
  supplierPowerScore         Decimal  @default(50) @db.Decimal(5, 2)
  recommendedStrategy        String? // CONSOLIDATE, DIVERSIFY, NEGOTIATE, DEVELOP, EXIT
  consolidationOpportunities Json     @default("[]")
  alternativeSuggestions     Json     @default("[]")
  predictedPriceDirection    String? // UP, DOWN, STABLE
  predictedPriceChange       Decimal? @db.Decimal(5, 2)
  churnRiskScore             Decimal? @db.Decimal(3, 2)
  optimalOrderSize           Decimal? @db.Decimal(15, 2)
  optimalOrderFrequency      String? // WEEKLY, MONTHLY, QUARTERLY
  estimatedAnnualValue       Decimal? @db.Decimal(15, 2)
  strengthFactors            Json     @default("[]")
  weaknessFactors            Json     @default("[]")
  behavioralInsights         Json     @default("{}")
  calculatedAt               DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_ai_profiles")
}

enum SupplierSegment {
  STRATEGIC_PARTNER
  LEVERAGE_SUPPLIER
  BOTTLENECK
  ROUTINE
  A_SUPPLIER
  B_SUPPLIER
  C_SUPPLIER
  AT_RISK
  PREFERRED
  DEVELOPING
  EXITING
}

model SupplierSegmentation {
  id         String          @id @default(cuid())
  supplierId String
  segment    SupplierSegment
  score      Decimal         @default(0) @db.Decimal(5, 2)
  assignedAt DateTime        @default(now())
  notes      String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, segment])
  @@index([supplierId])
  @@index([segment])
  @@map("supplier_segmentations")
}

// ============================================================
// M. PROJECT OS â€” Projects, Sprints, Milestones, Budget, Time
// ============================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  ACHIEVED
  MISSED
  CANCELLED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

model Project {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  ownerId        String?
  color          String        @default("#6366f1") // display color
  icon           String? // emoji or icon key
  startDate      DateTime?
  endDate        DateTime?
  completedAt    DateTime?
  // Budget
  budgetTotal    Decimal?      @db.Decimal(15, 2)
  budgetCurrency String        @default("XAF")
  // Settings
  settings       Json          @default("{}") // { velocityTarget, sprintLength, ... }
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  members    ProjectMember[]
  milestones Milestone[]
  phases     Phase[]
  sprints    Sprint[]
  budgets    Budget[]
  tasks      Task[]
  orders     Order[]

  @@index([tenantId, status])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id         String      @id @default(cuid())
  projectId  String
  userId     String
  role       ProjectRole @default(MEMBER)
  hourlyRate Decimal?    @db.Decimal(10, 2) // XAF/h for cost calculation
  currency   String      @default("XAF")
  joinedAt   DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  achievedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model Phase {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  color       String    @default("#94a3b8")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("phases")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  status    SprintStatus @default(PLANNING)
  startDate DateTime?
  endDate   DateTime?
  velocity  Int? // story points completed
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
  @@map("sprints")
}

model Budget {
  id        String   @id @default(cuid())
  projectId String
  category  String // LABOR, EXTERNAL, TOOLS, TRAVEL, OTHER
  label     String
  planned   Decimal  @db.Decimal(15, 2)
  actual    Decimal  @default(0) @db.Decimal(15, 2)
  currency  String   @default("XAF")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("budgets")
}

// â”€â”€ Time Entries (per-task, per-user, with billing) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TaskTimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  description String?
  minutes     Int // duration in minutes
  startedAt   DateTime
  endedAt     DateTime?
  hourlyRate  Decimal?  @db.Decimal(10, 2) // snapshot of rate at time of entry
  currency    String    @default("XAF")
  cost        Decimal?  @db.Decimal(15, 2) // computed: minutes/60 * hourlyRate
  billable    Boolean   @default(true)
  approved    Boolean   @default(false)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("task_time_entries")
}

// ============================================================
// O. WHATSAPP OS Ã¢â‚¬â€ Conversations, Intents, Templates, Campaigns
// ============================================================

enum WhatsappChannelType {
  GROUP
  BROADCAST
}

enum WhatsappConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum WhatsappConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WhatsappMessageDirection {
  IN
  OUT
}

enum WhatsappMessageType {
  TEXT
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  TEMPLATE
}

enum WhatsappTemplateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum WhatsappCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum WhatsappIntentScore {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WhatsappIntentStatus {
  DETECTED
  QUALIFIED
  TRANSFERRED
  WON
  LOST
}

enum WhatsappLeadStage {
  DETECTED
  CONTACTED
  QUALIFIED
  TRANSFERRED
  WON
  LOST
}

enum WhatsappSendStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsappAccount {
  id             String   @id @default(cuid())
  tenantId       String
  provider       String   @default("waha")
  phoneNumberId  String?
  displayName    String?
  wabaId         String?
  status         String   @default("active")
  rateLimitsJson Json     @default("{}")
  webhookSecret  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  channels      WhatsappChannel[]
  conversations WhatsappConversation[]
  webhookEvents WhatsappWebhookEvent[]

  @@index([tenantId])
  @@index([phoneNumberId])
  @@map("whatsapp_accounts")
}

model WhatsappChannel {
  id            String              @id @default(cuid())
  tenantId      String
  accountId     String
  type          WhatsappChannelType
  name          String
  externalId    String?
  category      String?
  membersCount  Int                 @default(0)
  status        String              @default("active")
  lastMessageAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  account WhatsappAccount       @relation(fields: [accountId], references: [id])
  members WhatsappGroupMember[]

  @@index([tenantId, type])
  @@index([accountId])
  @@map("whatsapp_channels")
}

model WhatsappGroupMember {
  id          String   @id @default(cuid())
  channelId   String
  waContactId String
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  channel WhatsappChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact WhatsappContact @relation(fields: [waContactId], references: [id], onDelete: Cascade)

  @@unique([channelId, waContactId])
  @@index([waContactId])
  @@map("whatsapp_group_members")
}

model WhatsappContact {
  id              String    @id @default(cuid())
  tenantId        String
  phone           String
  name            String?
  avatarUrl       String?
  country         String    @default("CG")
  linkedContactId String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  linkedContact    Contact?               @relation(fields: [linkedContactId], references: [id])
    conversations    WhatsappConversation[]
    groupMemberships WhatsappGroupMember[]
    campaigns        WhatsappCampaignSend[]
    intents          WhatsappIntent[]
    leads            WhatsappLeadPipeline[]
    warehouseIntakeDrafts WarehouseIntakeDraft[]

  @@unique([tenantId, phone])
  @@index([linkedContactId])
  @@map("whatsapp_contacts")
}

model WhatsappConversation {
  id             String                       @id @default(cuid())
  tenantId       String
  accountId      String
  waContactId    String
  status         WhatsappConversationStatus   @default(OPEN)
  assignedToId   String?
  ownerId        String?
  priority       WhatsappConversationPriority @default(NORMAL)
  slaDueAt       DateTime?
  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  intentScore    WhatsappIntentScore?
  tags           Json                         @default("[]")
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  account    WhatsappAccount           @relation(fields: [accountId], references: [id])
  contact    WhatsappContact           @relation(fields: [waContactId], references: [id])
  assignedTo User?                     @relation("WhatsappAssigned", fields: [assignedToId], references: [id])
  owner      User?                     @relation("WhatsappOwner", fields: [ownerId], references: [id])
    messages   WhatsappMessage[]
    intents    WhatsappIntent[]
    tagsRel    WhatsappConversationTag[]
    warehouseIntakeDrafts WarehouseIntakeDraft[]

  @@index([tenantId, status])
  @@index([assignedToId])
  @@index([waContactId])
  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id             String                   @id @default(cuid())
  conversationId String
  direction      WhatsappMessageDirection
  type           WhatsappMessageType      @default(TEXT)
  body           String?
  externalId     String?
  status         WhatsappSendStatus       @default(SENT)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  rawJson        Json                     @default("{}")
  createdAt      DateTime                 @default(now())

    conversation WhatsappConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    media        WhatsappMessageMedia[]
    warehouseIntakeDrafts WarehouseIntakeDraft[] @relation("WarehouseDraftSourceMessage")

  @@index([conversationId])
  @@index([externalId])
  @@map("whatsapp_messages")
}

model WhatsappMessageMedia {
  id        String  @id @default(cuid())
  messageId String
  url       String
  mimeType  String?
  size      Int?
  caption   String?

  message WhatsappMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("whatsapp_message_media")
}

model WhatsappTag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String   @default("#16a34a")
  createdAt DateTime @default(now())

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  conversations WhatsappConversationTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("whatsapp_tags")
}

model WhatsappConversationTag {
  id             String   @id @default(cuid())
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          WhatsappTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@map("whatsapp_conversation_tags")
}

model WhatsappTemplate {
  id        String                 @id @default(cuid())
  tenantId  String
  name      String
  category  String?
  language  String                 @default("fr")
  status    WhatsappTemplateStatus @default(DRAFT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  tenant   Tenant                    @relation(fields: [tenantId], references: [id])
  versions WhatsappTemplateVersion[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("whatsapp_templates")
}

model WhatsappTemplateVersion {
  id         String                 @id @default(cuid())
  templateId String
  body       String
  variables  Json                   @default("[]")
  status     WhatsappTemplateStatus @default(DRAFT)
  approvedAt DateTime?
  createdAt  DateTime               @default(now())

  template      WhatsappTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  campaignSends WhatsappCampaignSend[]

  @@index([templateId])
  @@map("whatsapp_template_versions")
}

model WhatsappCampaign {
  id          String                 @id @default(cuid())
  tenantId    String
  name        String
  objective   String?
  segment     String?
  status      WhatsappCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  createdBy User?                  @relation("WhatsappCampaignCreator", fields: [createdById], references: [id])
  sends     WhatsappCampaignSend[]

  @@index([tenantId, status])
  @@index([createdById])
  @@map("whatsapp_campaigns")
}

model WhatsappCampaignSend {
  id                String             @id @default(cuid())
  campaignId        String
  waContactId       String
  templateVersionId String?
  status            WhatsappSendStatus @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  error             String?

  campaign        WhatsappCampaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact         WhatsappContact          @relation(fields: [waContactId], references: [id], onDelete: Cascade)
  templateVersion WhatsappTemplateVersion? @relation(fields: [templateVersionId], references: [id])

  @@index([campaignId])
  @@index([waContactId])
  @@map("whatsapp_campaign_sends")
}

model WhatsappIntent {
  id              String               @id @default(cuid())
  tenantId        String
  conversationId  String
  waContactId     String?
  contactId       String?
  sourceMessageId String?
  score           WhatsappIntentScore  @default(LOW)
  summary         String?
  status          WhatsappIntentStatus @default(DETECTED)
  crmIntentId     String?
  qualifiedById   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant                     Tenant                    @relation(fields: [tenantId], references: [id])
  conversation               WhatsappConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappContact            WhatsappContact?          @relation(fields: [waContactId], references: [id])
  contact                    Contact?                  @relation(fields: [contactId], references: [id])
  crmIntent                  CustomerPipelineIntent?   @relation(fields: [crmIntentId], references: [id])
  qualifiedBy                User?                     @relation("WhatsappIntentQualifiedBy", fields: [qualifiedById], references: [id])
  customerFinancialMetrics   CustomerFinancialMetrics? @relation(fields: [customerFinancialMetricsId], references: [id])
  customerFinancialMetricsId String?

  @@index([tenantId, status])
  @@index([contactId])
  @@map("whatsapp_intents")
}

model WhatsappLeadPipeline {
  id           String            @id @default(cuid())
  tenantId     String
  waContactId  String
  stage        WhatsappLeadStage @default(DETECTED)
  assignedToId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  contact    WhatsappContact @relation(fields: [waContactId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("WhatsappLeadAssigned", fields: [assignedToId], references: [id])

  @@unique([tenantId, waContactId])
  @@index([tenantId, stage])
  @@index([assignedToId])
  @@map("whatsapp_lead_pipeline")
}

model WhatsappWebhookEvent {
  id          String    @id @default(cuid())
  accountId   String
  externalId  String?
  type        String
  payload     Json      @default("{}")
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  account WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId])
  @@map("whatsapp_webhook_events")
}

model WhatsappAuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("whatsapp_audit_logs")
}

// ============================================================
// ENTERPRISE CRM â€” Pipelines, Meetings, Nurturing
// ============================================================

model Pipeline {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean         @default(false)
  stages    PipelineStage[]
  leads     Lead[]
  createdAt DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id         String @id @default(cuid())
  pipelineId String
  name       String
  order      Int
  color      String @default("#6366f1")
  leads      Lead[]

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@map("pipeline_stages")
}

model Meeting {
  id          String   @id @default(cuid())
  tenantId    String
  contactId   String
  leadId      String?
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  type        String   @default("CALL")
  status      String   @default("SCHEDULED")
  createdById String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([startAt])
  @@map("meetings")
}

model NurturingSequence {
  id            String                @id @default(cuid())
  tenantId      String
  name          String
  trigger       String
  triggerStatus String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  steps         NurturingStep[]
  enrollments   NurturingEnrollment[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("nurturing_sequences")
}

model NurturingStep {
  id         String  @id @default(cuid())
  sequenceId String
  order      Int
  delayDays  Int     @default(0)
  channel    String
  subject    String?
  body       String

  sequence NurturingSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@map("nurturing_steps")
}

model NurturingEnrollment {
  id          String    @id @default(cuid())
  sequenceId  String
  leadId      String
  currentStep Int       @default(0)
  status      String    @default("ACTIVE")
  enrolledAt  DateTime  @default(now())
  nextStepAt  DateTime?

  sequence NurturingSequence @relation(fields: [sequenceId], references: [id])
  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

