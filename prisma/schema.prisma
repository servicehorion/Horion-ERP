  @@index([sessionId])
  @@index([messageId])
  @@map("assistant_feedback")
}

model KnowledgeDocument {
  id          String              @id @default(cuid())
  tenantId    String
  audience    KnowledgeAudience
  sourceType  KnowledgeSourceType @default(MANUAL)
  title       String
  slug        String?
  module      String?
  sourceUrl   String?
  externalRef String?
  tags        Json                @default("[]")
  content     String
  status      String              @default("ACTIVE")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  chunks KnowledgeChunk[]

  @@unique([tenantId, audience, title])
  @@index([tenantId, audience, module])
  @@index([slug])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id           String   @id @default(cuid())
  documentId   String
  ordinal      Int
  module       String?
  content      String
  tags         Json     @default("[]")
  embeddingRef String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([module])
  @@map("knowledge_chunks")
}

model AssistantAuditLog {
  id            String        @id @default(cuid())
  tenantId      String
  assistantType AssistantType
  sessionId     String?
  action        String
  entityType    String?
  entityId      String?
  input         Json          @default("{}")
  output        Json          @default("{}")
  status        String        @default("SUCCESS")
  errorMessage  String?
  createdAt     DateTime      @default(now())

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  session AssistantSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, assistantType])
  @@index([sessionId])
  @@index([entityType, entityId])
  @@map("assistant_audit_logs")
}

// ============================================================
// S. WAREHOUSE RECEIPT — données internes, jamais exposées client
// ============================================================

enum WarehouseReceiptCondition {
  OK
  DAMAGED
  WRONG_ITEM
  PARTIAL
}

model WarehouseReceipt {
  id         String   @id @default(cuid())
  shipmentId String   @unique
  orderId    String

  receivedAt   DateTime @default(now())
  receivedById String?  // agent en Chine (User.id)

  // ── Poids RÉEL — 100% interne, jamais exposé au client ──────
  actualWeightKg     Decimal  @db.Decimal(10, 3)
  actualLengthCm     Decimal? @db.Decimal(10, 2)
  actualWidthCm      Decimal? @db.Decimal(10, 2)
  actualHeightCm     Decimal? @db.Decimal(10, 2)
  volumetricWeightKg Decimal  @db.Decimal(10, 3) // calculé auto : (L×W×H)/6000
  chargeableWeightKg Decimal  @db.Decimal(10, 3) // ceil(max(actual, volumetric))

  // ── QC visuel ────────────────────────────────────────────────
  condition      WarehouseReceiptCondition @default(OK)
  conditionNotes String?
  photoUrls      Json                      @default("[]") // [photo_ext, photo_open, photo_detail]

  // ── Stockage physique ─────────────────────────────────────────
  warehouseLocation String? // ex: "Section B-12"
  consolidationNote String? // "Attendre CMD-1235 avant expédition"
  readyToShip       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
  receivedBy User?    @relation("WarehouseReceiptAgent", fields: [receivedById], references: [id])

  @@index([orderId])
  @@map("warehouse_receipts")
}
