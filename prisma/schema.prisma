model InboundIntent {
  id              String    @id @default(cuid())
  contactId       String
  sourceMessageId String?
  intentType      String
  category        String?
  urgency         String    @default("normal")
  budgetHint      String?
  confidence      Decimal   @db.Decimal(3, 2) @default(0)
  routedTo        String?
  processedAt     DateTime?
