model AgentLog {
  id            String   @id @default(cuid())
  tenantId      String
  agentId       String?  // Identifiant agent IA (ex: "AUTO_INDICATIF", "QC_ANALYZER")
  agentType     String   // Type fonctionnel de l'agent
