// ============================================================
// D. SOURCING
// ============================================================

// ── D0. SourcingTicket (pivot pré-vente) ──────────────────────

enum SourcingTicketStatus {
  CREATED
  INTERNAL_SCANNING
  CATALOG_MATCH_REVIEW
  EXTERNAL_SOURCING_PENDING
  PENDING_PARTNER_INFO
  QUOTE_READY
  QUOTED
  CLIENT_ACCEPTED
  ORDERED
  CONVERTED
  LOST
}

model SourcingTicket {
  id                  String               @id @default(cuid())
  tenantId            String
  demandId            String?
  contactId           String?
  leadId              String?
  quoteId             String?
  orderId             String?
  status              SourcingTicketStatus @default(CREATED)
  description         String
  category            String?
  quantity            Int?
  targetPrice         Decimal?             @db.Decimal(15, 2)
  currency            String               @default("USD")
  catalogProductId    String?
  catalogMatchScore   Decimal?             @db.Decimal(5, 2)
  catalogMatchSource  String?              // EXACT | FUZZY | CATEGORY | NONE
  imageVectorId       String?
  internalDecision    String?              // USE_CATALOG | EXTERNAL_SOURCING | MANUAL
  externalProvider    String?
  estimatedWeight     Decimal?             @db.Decimal(10, 3)
  estimatedDimensions Json?                // {l, w, h, unit}
  pricingSnapshot     Json                 @default("{}")
  assignedToId        String?
  assignedAgent       String?              // AI agent identifier
  convertedAt         DateTime?
  lostAt              DateTime?
  lostReason          String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  demand         DemandIntake?   @relation(fields: [demandId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  lead           Lead?           @relation(fields: [leadId], references: [id])
  catalogProduct CatalogProduct? @relation("SourcingTicketProduct", fields: [catalogProductId], references: [id])
  assignedTo     User?           @relation("SourcingTicketAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId, status])
  @@index([demandId])
  @@index([contactId])
  @@index([assignedToId])
  @@map("sourcing_tickets")
}

model Supplier {
  id                        String                  @id @default(cuid())
  name                      String
  country                   String                  @default("CN")
  city                      String?
  platform                  String? // 1688, alibaba, offline
  status                    SupplierStatus          @default(ACTIVE)
  contactName               String?
  phone                     String?
  wechat                    String?
  whatsapp                  String?
  email                     String?
  website                   String?
  storeUrl                  String?
  address                   String?
  category                  String?
  rating                    Int                     @default(50)
  leadTimeDays              Int?
  sampleLeadTimeDays        Int?
  responseTimeHours         Int?
  productionCapacityMonthly Int?
  moq                       String?
  paymentTerms              String?
  contactsJson              Json                    @default("{}") // WeChat, WhatsApp, email, horaires, langue
  negotiatedTermsJson       Json                    @default("{}") // paiement, incoterm, d????lais, garanties
  languagesJson             Json                    @default("[]")
  certificationsJson        Json                    @default("[]")
  qcPassRate                Decimal?                @db.Decimal(5, 2)
  logisticsReliability      Decimal?                @db.Decimal(5, 2)
  incidentRate              Decimal?                @db.Decimal(5, 2)
  notes                     String?
  isVerified                Boolean                 @default(false)
  lifecycleStatus           SupplierLifecycleStatus @default(ACTIVE)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  offers               Offer[]
  sourcingCases        SourcingCase[]
  supplierScores       SupplierScore[]
  supplierProducts     SupplierProduct[]
  catalogMedia         CatalogMedia[]
  documents            SupplierDocument[]
  sourcingDecisions    SourcingDecision[]
  orderItems           OrderItem[]
  customerSupplyChains CustomerSupplyChain[]
  invoices             Invoice[]

  // Supplier Intelligence
  financialMetrics   SupplierFinancialMetrics?
  performanceProfile SupplierPerformanceProfile?
  riskProfile        SupplierRiskProfile?
  aiProfile          SupplierAIProfile?
  segmentations      SupplierSegmentation[]
  ediTransmissions   OrderEdiTransmission[]
  qcInspections      QcInspection[]              @relation("SupplierQcInspections")
  qcRequests         QCRequest[]
  qcReports          QCReport[]
  contracts          SupplierContract[]

  @@map("suppliers")
}

enum SupplierStatus {
  ACTIVE
  TESTING
  SUSPENDED
  BLACKLIST
}

enum SupplierLifecycleStatus {
  ACTIVE
  DORMANT
  BLACKLISTED
  STRATEGIC
}

enum SupplierContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model SupplierContract {
  id             String                 @id @default(cuid())
  tenantId       String
  supplierId     String
  contractNumber String
  status         SupplierContractStatus @default(DRAFT)
  title          String
  startAt        DateTime
  endAt          DateTime?
  currency       String                 @default("USD")
  negotiatedBy   String?
  termsJson      Json                   @default("{}")
  priceGrid      Json                   @default("{}")
  penaltyClauses Json                   @default("{}")
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sourcingCases SourcingCase[]

  @@unique([tenantId, contractNumber])
  @@index([tenantId, status])
  @@index([supplierId, status])
  @@map("supplier_contracts")
}

model SupplierScore {
  id         String   @id @default(cuid())
  supplierId String
  dimension  String
  score      Int
  orderId    String?
  notes      String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_scores")
}

model SourcingCase {
  id             String         @id @default(cuid())
  orderId        String
  supplierId     String?
  contractId     String?
  status         SourcingStatus @default(SEARCHING)
  level          SourcingLevel  @default(INFORMATIF)
  requirement    String
  budget         Decimal?       @db.Decimal(15, 2)
  currency       String         @default("RMB")
  selectedAt     DateTime?
  category       String?
  pipelineType   PipelineType   @default(RETAIL)
  assignedToId   String?
  assignedAgent  String?
  stageEnteredAt DateTime       @default(now())
  qcCostEst      Decimal?       @db.Decimal(15, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Sourcing context
  platform         String? // 1688, taobao, alibaba, aliexpress, amazon, web
  bufferPercent    Decimal? @db.Decimal(5, 2) // 15-20 for informatif
  sensitiveProduct Boolean  @default(false)

  // Dimensions (required for profond)
  weightKg    Decimal? @db.Decimal(10, 3)
  lengthCm    Decimal? @db.Decimal(10, 2)
  widthCm     Decimal? @db.Decimal(10, 2)
  heightCm    Decimal? @db.Decimal(10, 2)
  cartonCount Int?

  // Calculated transport
  volumetricWeightKg Decimal? @db.Decimal(10, 3)
  taxableWeightKg    Decimal? @db.Decimal(10, 3)
  transportCostEst   Decimal? @db.Decimal(15, 2)
  transportCurrency  String   @default("XAF")
  transportBufferPct Decimal? @db.Decimal(5, 2) // 5-8%

  // Margin simulation
  unitPriceRmb        Decimal?  @db.Decimal(15, 2)
  quantity            Int?
  totalCostXAF        Decimal?  @db.Decimal(15, 2)
  prixFinalXAF        Decimal?  @db.Decimal(15, 2)
  marginPct           Decimal?  @db.Decimal(5, 2)
  marginApprovedByCeo Boolean   @default(false)
  ceoApprovedAt       DateTime?

  // Data capitalization
  weightEstimated    Decimal? @db.Decimal(10, 3)
  weightReal         Decimal? @db.Decimal(10, 3)
  marginPrevue       Decimal? @db.Decimal(5, 2)
  marginReelle       Decimal? @db.Decimal(5, 2)
  delayEstimatedDays Int?
  delayRealDays      Int?

  order              Order               @relation(fields: [orderId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  contract           SupplierContract?   @relation(fields: [contractId], references: [id])
  assignedTo         User?               @relation("SourcingCaseAssignee", fields: [assignedToId], references: [id])
  offers             Offer[]
  negotiations       NegotiationLog[]
  groupageBatchItems GroupageBatchItem[]
  decisions          SourcingDecision[]
  convertedDemands   DemandIntake[]

  @@index([orderId])
  @@index([contractId])
  @@index([level])
  @@map("sourcing_cases")
}

enum SourcingLevel {
  INFORMATIF
  PROFOND
}

enum SourcingStatus {
  SEARCHING
  OFFERS_RECEIVED
  NEGOTIATING
  SELECTED
  CONFIRMED
  CANCELLED
}

enum PipelineType {
  RETAIL
  WHOLESALE
  VIP
  STRATEGIC
}

enum DemandSource {
  WHATSAPP
  PHONE
  EMAIL
  GROUP
  CRM
  APP
  MANUAL
}

enum DemandStatus {
  RAW
  QUALIFIED
  INDICATIF_PENDING
  QUOTE_DRAFT
  QUOTE_PENDING_APPROVAL
  QUOTE_APPROVED
  QUOTE_SENT
  CLIENT_ACCEPTED
  PAYMENT_SUBMITTED
  PAYMENT_VALIDATED
  CONVERTED
  LOST
}

enum DemandUrgency {
  NORMAL
  HIGH
  CRITICAL
}

enum ClientSegment {
  VIP
  STANDARD
  RISK
}

enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarketTrend {
  TIGHTENING
  LOOSENING
  STABLE
}

enum MarketTiming {
  BUY_NOW
  WAIT
  URGENT
}

model Offer {
  id                String    @id @default(cuid())
  sourcingCaseId    String?
  supplierId        String
  supplierProductId String?
  productId         String?
  unitPrice         Decimal   @db.Decimal(15, 2)
  currency          String    @default("RMB")
  moq               Int?
  leadTimeDays      Int?
  sampleAvailable   Boolean   @default(false)
  notes             String?
  isSelected        Boolean   @default(false)
  validFrom         DateTime  @default(now())
  validTo           DateTime?
  sourceType        String    @default("sourcing") // sourcing, order, manual
  sourceId          String?
  createdAt         DateTime  @default(now())

  sourcingCase    SourcingCase?    @relation(fields: [sourcingCaseId], references: [id])
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  product         CatalogProduct?  @relation(fields: [productId], references: [id])

  @@index([sourcingCaseId])
  @@index([supplierId])
  @@index([productId])
  @@index([supplierProductId])
  @@map("offers")
}

model NegotiationLog {
  id             String   @id @default(cuid())
  sourcingCaseId String
  message        String
  direction      String
  channel        String?
  createdAt      DateTime @default(now())

  sourcingCase SourcingCase @relation(fields: [sourcingCaseId], references: [id])

  @@index([sourcingCaseId])
  @@map("negotiation_logs")
}

model DemandIntake {
  id               String        @id @default(cuid())
  tenantId         String
  source           DemandSource
  sourceRef        String?
  sourcePayload    Json?
  clientName       String
  clientSegment    ClientSegment @default(STANDARD)
  rawDescription   String
  category         String?
  quantity         Int?
  targetPrice      Decimal?      @db.Decimal(15, 2)
  currency         String        @default("USD")
  urgency          DemandUrgency @default(NORMAL)
  country          String?
  estimatedRevenue Decimal?      @db.Decimal(15, 2)
  status           DemandStatus  @default(RAW)
  receivedAt       DateTime      @default(now())
  aiScore          Int           @default(50)
  rejectionReason  String?
  qualifiedById    String?
  assignedToId     String?
  convertedCaseId  String?
  convertedAt      DateTime? // Date de conversion DemandIntake → Order
  convertedQuoteId String?   // Devis ayant déclenché la conversion
  contactId        String?
  leadId           String?
  orderId          String?
  quoteId          String?
  cmId             String?

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  qualifiedBy   User?              @relation("DemandQualifiedBy", fields: [qualifiedById], references: [id])
  assignedTo    User?              @relation("DemandAssignee", fields: [assignedToId], references: [id])
  cm              User?              @relation("DemandCm", fields: [cmId], references: [id])
  convertedCase   SourcingCase?      @relation(fields: [convertedCaseId], references: [id])
  contact         Contact?           @relation(fields: [contactId], references: [id])
  lead            Lead?              @relation(fields: [leadId], references: [id])
  order           Order?             @relation(fields: [orderId], references: [id])
  attachments     DemandAttachment[]
  sourcingTickets SourcingTicket[]

  @@unique([tenantId, source, sourceRef])
  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([assignedToId])
  @@index([contactId])
  @@index([cmId])
  @@map("demand_intakes")
}

model DemandAttachment {
  id        String   @id @default(cuid())
  demandId  String
  name      String
  url       String
  type      String   @default("link")
  createdAt DateTime @default(now())

  demand DemandIntake @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([demandId])
  @@map("demand_attachments")
}

model SourcingDecision {
  id             String         @id @default(cuid())
  sourcingCaseId String
  supplierId     String?
  status         DecisionStatus @default(PENDING)
  note           String?
  marginImpact   Decimal?       @db.Decimal(15, 2)
  decidedById    String?
  createdAt      DateTime       @default(now())

  sourcingCase SourcingCase @relation(fields: [sourcingCaseId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  decidedBy    User?        @relation(fields: [decidedById], references: [id])

  @@index([sourcingCaseId])
  @@map("sourcing_decisions")
}

model SourcingMarketInsight {
  id                String       @id @default(cuid())
  tenantId          String
  product           String
  category          String?
  currentPrice      Decimal      @db.Decimal(15, 2)
  priceChange30d    Decimal      @db.Decimal(5, 2)
  volatilityScore   Int          @default(0)
  marketTrend       MarketTrend  @default(STABLE)
  recommendedTiming MarketTiming @default(WAIT)
  averageMOQ        Int          @default(0)
  supplierCount     Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("sourcing_market_insights")
}

model SupplierDocument {
  id         String    @id @default(cuid())
  supplierId String
  name       String
  url        String
  type       String    @default("document")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_documents")
}

// ============================================================
// D2. TRANSPORT PALIERS & GROUPAGE
// ============================================================

model TransportPalier {
  id          String   @id @default(cuid())
  tenantId    String?
  mode        String   @default("AIR") // AIR, SEA, ROAD
  fromKg      Decimal  @db.Decimal(10, 3)
  toKg        Decimal? @db.Decimal(10, 3) // null = no upper bound
  ratePerKg   Decimal  @db.Decimal(10, 2) // FCFA/kg
  currency    String   @default("XAF")
  destination String   @default("CG")
  isSensitive Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([mode, destination, isSensitive])
  @@map("transport_paliers")
}

model GroupageBatch {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  destination String    @default("CG")
  status      String    @default("FORMING") // FORMING, CONFIRMED, SHIPPED, CLOSED
  mode        String    @default("SEA")
  totalCbm    Decimal?  @db.Decimal(10, 4)
  totalWeight Decimal?  @db.Decimal(10, 3)
  etd         DateTime?
  eta         DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  items     GroupageBatchItem[]
  shipments Shipment[]

  @@index([tenantId])
  @@map("groupage_batches")
}

model GroupageBatchItem {
  id             String   @id @default(cuid())
  batchId        String
  sourcingCaseId String
  weightKg       Decimal? @db.Decimal(10, 3)
  cbm            Decimal? @db.Decimal(10, 4)
  notes          String?
  createdAt      DateTime @default(now())

  batch        GroupageBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourcingCase SourcingCase  @relation(fields: [sourcingCaseId], references: [id])

  @@unique([batchId, sourcingCaseId])
  @@index([batchId])
  @@map("groupage_batch_items")
}

// ============================================================
// E. QC (CONTROLE QUALITE)
// ============================================================

model QCRequest {
  id                 String    @id @default(cuid())
  orderId            String
  type               QCType    @default(PRE_SHIPMENT)
  level              QCLevel   @default(VIRTUAL)
  status             QCStatus  @default(PENDING)
  inspector          String?
  partnerId          String?
  supplierId         String?
  productId          String?
  cost               Decimal?  @db.Decimal(15, 2)
  currency           String    @default("USD")
  scheduledAt        DateTime?
  completedAt        DateTime?
  decisionNotes      String?
  clientApprovedAt   DateTime?
