// Horion ERP - Schema Prisma complet
// Infrastructure commerciale Chine -> Congo
// ~43 modeles couvrant tous les domaines metier

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailStatus {
  SENT
  OPENED
  CLICKED
}

// ============================================================
// A. IDENTITY & ACCESS
// ============================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  country   String   @default("CG")
  currency  String   @default("XAF")
  timezone  String   @default("Africa/Brazzaville")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  orders                     Order[]
  orderApprovalRules         OrderApprovalRule[]
  contacts                   Contact[]
  tasks                      Task[]
  projects                   Project[]
  ledgerAccounts             LedgerAccount[]
  auditLogs                  AuditLog[]
  delegationRules            DelegationRule[]
  channels                   Channel[]
  catalogProducts            CatalogProduct[]
  productCategories          ProductCategory[]
  catalogMedia               CatalogMedia[]
  qcInspections              QcInspection[]
  qcPartnerProfiles          QcPartnerProfile[]
  taskTemplates              TaskTemplate[]
  recurringTasks             RecurringTask[]
  notifications              Notification[]
  groupageBatches            GroupageBatch[]
  demandIntakes              DemandIntake[]
  catalogSourcingHistory     CatalogSourcingHistory[]
  marketInsights             SourcingMarketInsight[]
  accountingPeriods          AccountingPeriod[]
  journals                   Journal[]
  journalEntries             JournalEntry[]
  invoices                   Invoice[]
  financeApprovals           FinanceApproval[]
  financeApprovalRules       FinanceApprovalRule[]
  budgetPlans                BudgetPlan[]
  forecastScenarios          ForecastScenario[]
  cashPlans                  CashPlan[]
  legalEntities              LegalEntity[]
  consolidationRuns          ConsolidationRun[]
  taxRates                   TaxRate[]
  taxReports                 TaxReport[]
  bankConnections            BankConnection[]
  bankReconciliations        BankReconciliation[]
  marketDataRecords          MarketData[]
  exposures                  Exposure[]
  riskMetrics                RiskMetric[]
  costCenters                CostCenter[]
  assetCategories            AssetCategory[]
  fixedAssets                FixedAsset[]
  assetDepreciations         AssetDepreciation[]
  payrollProfiles            PayrollProfile[]
  payrollRuns                PayrollRun[]
  whatsappAccounts           WhatsappAccount[]
  whatsappContacts           WhatsappContact[]
  whatsappConversations      WhatsappConversation[]
  whatsappChannels           WhatsappChannel[]
  whatsappTemplates          WhatsappTemplate[]
  whatsappCampaigns          WhatsappCampaign[]
  whatsappIntents            WhatsappIntent[]
  whatsappTags               WhatsappTag[]
  whatsappAuditLogs          WhatsappAuditLog[]
  emailLogs                  EmailLog[]
  pipelines                  Pipeline[]
  meetings                   Meeting[]
  nurturingSequences         NurturingSequence[]
  qcPlans                    QcPlan[]
  emailCampaigns             EmailCampaign[]
  botFlows                   BotFlow[]
  savedFilters               SavedFilter[]
  goals                      Goal[]
  crmInboundSources          CrmInboundSource[]
  crmInboundEvents           CrmInboundEvent[]
  leadMiningProviders        LeadMiningProvider[]
  leadMiningJobs             LeadMiningJob[]
  leadMiningResults          LeadMiningResult[]
  salesTeams                 SalesTeam[]
  salesTerritories           SalesTerritory[]
  salesQuotas                SalesQuota[]
  leadScoreModels            LeadScoreModel[]
  leadScoreSnapshots         LeadScoreSnapshot[]
  strategicDecisions         StrategicDecision[]
  decisionExecutionTemplates DecisionExecutionTemplate[]
  strategicRisks             StrategicRisk[]
  supplierContracts          SupplierContract[]
  returnMerchandises         ReturnMerchandise[]
  qcLabConnections           QcLabConnection[]
  qcSpcCharts                QcSpcChart[]
  qcLotTraces                QcLotTrace[]
  agentLogs                  AgentLog[]
  sourcingTickets            SourcingTicket[]
  treasuryAccounts           TreasuryAccount[]
  warehouseIntakeDrafts      WarehouseIntakeDraft[]
  assistantSessions          AssistantSession[]
  knowledgeDocuments         KnowledgeDocument[]
  assistantAuditLogs         AssistantAuditLog[]

  @@map("tenants")
}

model User {
  id          String    @id @default(cuid())
  tenantId    String
  email       String    @unique
  password    String
  name        String
  role        UserRole  @default(OPS)
  avatarUrl   String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant                        Tenant                      @relation(fields: [tenantId], references: [id])
  taskAssignments               TaskAssignment[]
  approvals                     Approval[]
  financeApprovalsRequested     FinanceApproval[]           @relation("FinanceApprovalRequestedBy")
  financeApprovalsApproved      FinanceApproval[]           @relation("FinanceApprovalApprovedBy")
  financeApprovalsEscalated     FinanceApproval[]           @relation("FinanceApprovalEscalatedBy")
  auditLogs                     AuditLog[]
  taskComments                  TaskComment[]
  taskWatchers                  TaskWatcher[]
  taskAttachments               TaskAttachment[]
  notifications                 Notification[]
  ownedContacts                 Contact[]                   @relation("ContactOwner")
  approvedOrders                Order[]                     @relation("OrderApprovedBy")
  orderApprovalDecisions        OrderApproval[]             @relation("OrderApprovalDecidedBy")
  orderRevisionsCreated         OrderRevision[]             @relation("OrderRevisionCreatedBy")
  onboardedContacts             Contact[]                   @relation("ContactOnboardedBy")
  contactCollaborations         ContactCollaborator[]
  ownedLeads                    Lead[]                      @relation("LeadOwner")
  onboardedLeads                Lead[]                      @relation("LeadOnboardedBy")
  leadCollaborations            LeadCollaborator[]
  ownedOrders                   Order[]                     @relation("OrderOwner")
  onboardedOrders               Order[]                     @relation("OrderOnboardedBy")
  orderCollaborations           OrderCollaborator[]
  orderAttachments              OrderAttachment[]
  approvedQuotes                Quote[]                     @relation("QuoteApprovedBy")
  projectMembers                ProjectMember[]
  timeEntries                   TaskTimeEntry[]
  payrollProfile                PayrollProfile?
  payrollLines                  PayrollLine[]
  payrollRunsCreated            PayrollRun[]                @relation("PayrollRunCreatedBy")
  assignedSourcingCases         SourcingCase[]              @relation("SourcingCaseAssignee")
  qualifiedDemands              DemandIntake[]              @relation("DemandQualifiedBy")
  assignedDemands               DemandIntake[]              @relation("DemandAssignee")
  cmDemands                     DemandIntake[]              @relation("DemandCm")
  sourcingDecisions             SourcingDecision[]
  whatsappAssignedConversations WhatsappConversation[]      @relation("WhatsappAssigned")
  whatsappOwnedConversations    WhatsappConversation[]      @relation("WhatsappOwner")
  whatsappCampaigns             WhatsappCampaign[]          @relation("WhatsappCampaignCreator")
  whatsappQualifiedIntents      WhatsappIntent[]            @relation("WhatsappIntentQualifiedBy")
  whatsappAssignedLeadPipelines WhatsappLeadPipeline[]      @relation("WhatsappLeadAssigned")
  whatsappAuditLogs             WhatsappAuditLog[]
  delegationsGiven              DelegationRule[]            @relation("DelegationDelegator")
  delegationsReceived           DelegationRule[]            @relation("DelegationDelegatee")
  qcInspections                 QcInspection[]              @relation("QcInspector")
  qcRequestsApproved            QCRequest[]                 @relation("QcClientApprovedBy")
  qcReportsShared               QCReport[]                  @relation("QcReportSharedBy")
  emailCampaignsCreated         EmailCampaign[]             @relation("EmailCampaignCreator")
  taskCommentReactions          TaskCommentReaction[]
  savedFilters                  SavedFilter[]
  goalsOwned                    Goal[]                      @relation("GoalOwner")
  strategicDecisionsOwned       StrategicDecision[]         @relation("DecisionOwner")
  decisionExecutionTemplates    DecisionExecutionTemplate[]
  strategicRisksOwned           StrategicRisk[]             @relation("StrategicRiskOwner")
  riskMitigationEntries         RiskMitigationEntry[]       @relation("RiskMitigationAuthor")
  managedSalesTeams             SalesTeam[]                 @relation("SalesTeamManager")
  salesTeamMemberships          SalesTeamMember[]
  salesQuotas                   SalesQuota[]
  requestedReturns              ReturnMerchandise[]         @relation("ReturnRequestedBy")
  approvedReturns               ReturnMerchandise[]         @relation("ReturnApprovedBy")
  assignedSourcingTickets       SourcingTicket[]            @relation("SourcingTicketAssignee")
  warehouseReceiptsAsAgent      WarehouseReceipt[]          @relation("WarehouseReceiptAgent")
  validatedWarehouseIntakeDrafts WarehouseIntakeDraft[]    @relation("WarehouseIntakeDraftValidator")
  assistantSessions             AssistantSession[]
  twoFactorSecret               TwoFactorSecret?

  twoFactorEnabled Boolean @default(false)

  @@index([tenantId])
  @@map("users")
}

model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String // base32-encoded TOTP secret (store encrypted in prod)
  backupCodes Json     @default("[]") // hashed one-time backup codes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("two_factor_secrets")
}

enum UserRole {
  ADMIN
  CEO
  DIRECTION
  CTO
  AI_ENGINEER
  CRM_MANAGER
  COMMERCIAL
  COMMUNITY_MANAGER
  LOGISTICS_MANAGER
  LOGISTICS_ASSISTANT
  SOURCING_ASSISTANT
  FINANCE_MANAGER
  FINANCE
  OPS
  VIEWER
}

model DelegationRule {
  id           String    @id @default(cuid())
  tenantId     String
  delegatorId  String?
  delegateeId  String?
  permissions  Json      @default("[]")
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  maxAmountXAF Decimal?  @db.Decimal(15, 2)
  maxAmountUSD Decimal?  @db.Decimal(15, 2)
  maxAmountRMB Decimal?  @db.Decimal(15, 2)
  conditions   Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  delegator User?  @relation("DelegationDelegator", fields: [delegatorId], references: [id])
  delegatee User?  @relation("DelegationDelegatee", fields: [delegateeId], references: [id])

  @@index([tenantId, delegatorId])
  @@index([tenantId, delegateeId])
  @@map("delegation_rules")
}

// ============================================================
// B. CRM & CLIENT INTELLIGENCE
// ============================================================

model Contact {
  id            String      @id @default(cuid())
  tenantId      String
  type          ContactType
  name          String
  company       String?
  phone         String?
  email         String?
  whatsapp      String?
  city          String?
  country       String      @default("CG")
  notes         String?
  trustScore    Int         @default(50)
  tags          Json        @default("[]")
  customFields  Json?
  ownerId       String?
  onboardedById String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  owner                User?                     @relation("ContactOwner", fields: [ownerId], references: [id])
  onboardedBy          User?                     @relation("ContactOnboardedBy", fields: [onboardedById], references: [id])
  collaborators        ContactCollaborator[]
  orders               Order[]
  invoices             Invoice[]
  leads                Lead[]
  conversations        Conversation[]
  communityMemberships CommunityMembership[]
  engagementEvents     EngagementEvent[]
  inboundIntents       InboundIntent[]
  financialMetrics     CustomerFinancialMetrics?
  riskProfile          CustomerRiskProfile?
  pipelineIntents      CustomerPipelineIntent[]
  whatsappIntents      WhatsappIntent[]
  aiProfile            CustomerAIProfile?
  qcPartnerProfile     QcPartnerProfile?
  qcPartnerRequests    QCRequest[]               @relation("QcPartner")
  supplyChains         CustomerSupplyChain[]
  segmentations        CustomerSegmentation[]
  whatsappProfiles     WhatsappContact[]
  demandIntakes        DemandIntake[]
  meetings             Meeting[]
  emailLogs            EmailLog[]
  emailRecipients      EmailRecipient[]
  crmInboundEvents          CrmInboundEvent[]
  leadMiningResults         LeadMiningResult[]
  sourcingTickets           SourcingTicket[]
  customsBrokerClearances   OrderCustomsClearance[]     @relation("CustomsBroker")

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([ownerId])
  @@index([onboardedById])
  @@map("contacts")
}

enum ContactType {
  CLIENT
  PROSPECT
  SUPPLIER
  FREIGHT_PARTNER
  CUSTOMS_BROKER
  QC_PARTNER
  OTHER
}

model Lead {
  id              String         @id @default(cuid())
  contactId       String
  status          LeadStatus     @default(NEW)
  source          String?
  description     String?
  estimatedValue  Decimal?       @db.Decimal(15, 2)
  currency        String         @default("XAF")
  category        String?
  assignedTo      String?
  ownerId         String?
  onboardedById   String?
  containerType   ContainerType?
  originCountry   String?        @default("CN")
  notes           String?
  isArchived      Boolean        @default(false)
  archivedAt      DateTime?
  score           Int            @default(0)
  winProbability  Int            @default(0)
  scoredAt        DateTime?
  slaDeadline     DateTime?
  slaStatus       String?
  customFields    Json?
  pipelineId      String?
  pipelineStageId String?
  salesTeamId     String?
  territoryId     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contact              Contact               @relation(fields: [contactId], references: [id])
  owner                User?                 @relation("LeadOwner", fields: [ownerId], references: [id])
  onboardedBy          User?                 @relation("LeadOnboardedBy", fields: [onboardedById], references: [id])
  collaborators        LeadCollaborator[]
  pipeline             Pipeline?             @relation(fields: [pipelineId], references: [id])
  pipelineStage        PipelineStage?        @relation(fields: [pipelineStageId], references: [id])
  salesTeam            SalesTeam?            @relation(fields: [salesTeamId], references: [id])
  territory            SalesTerritory?       @relation(fields: [territoryId], references: [id])
  inboundEvents        CrmInboundEvent[]
  orders               Order[]
  scoreSnapshots       LeadScoreSnapshot[]
  leadMiningResults    LeadMiningResult[]
  nurturingEnrollments NurturingEnrollment[]
  meetings             Meeting[]
  emailLogs            EmailLog[]
  demandIntakes        DemandIntake[]
  sourcingTickets      SourcingTicket[]

  @@index([contactId])
  @@index([ownerId])
  @@index([onboardedById])
  @@index([isArchived])
  @@index([score])
  @@index([slaStatus])
  @@index([salesTeamId])
  @@index([territoryId])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

enum ContainerType {
  LCL
  FCL
  AERIEN
}

model ContactCollaborator {
  id        String   @id @default(cuid())
  contactId String
  userId    String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([contactId, userId])
  @@index([userId])
  @@map("contact_collaborators")
}

model LeadCollaborator {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([leadId, userId])
  @@index([userId])
  @@map("lead_collaborators")
}

model Conversation {
  id         String   @id @default(cuid())
  contactId  String
  channelId  String?
  platform   String   @default("whatsapp")
  externalId String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contact  Contact   @relation(fields: [contactId], references: [id])
  channel  Channel?  @relation(fields: [channelId], references: [id])
  messages Message[]

  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String
  senderType     String   @default("human")
  content        String
  contentType    String   @default("text")
  mediaUrl       String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

model EmailLog {
  id         String      @id @default(cuid())
  tenantId   String
  contactId  String?
  leadId     String?
  subject    String
  body       String
  status     EmailStatus @default(SENT)
  sentAt     DateTime    @default(now())
  openedAt   DateTime?
  clickedAt  DateTime?
  provider   String?     @default("resend")
  providerId String?
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([leadId])
  @@index([providerId])
  @@map("email_logs")
}

// ============================================================
// C. COMMERCE / ORDERS (NOYAU CENTRAL)
// ============================================================

model Order {
  id                String              @id @default(cuid())
  tenantId          String
  orderNumber       String              @unique
  contactId         String
  currentQuoteId    String?
  ownerId           String?
  onboardedById     String?
  projectId         String?
  leadId            String?
  status            OrderStatus         @default(DEMANDE)
  approvalStatus    OrderApprovalStatus @default(NOT_REQUIRED)
  approvedById      String?
  approvedAt        DateTime?
  priority          Priority            @default(NORMAL)
  merchandiseTotal  Decimal             @default(0) @db.Decimal(15, 2)
  logisticsCost     Decimal             @default(0) @db.Decimal(15, 2)
  commissionRate    Decimal             @default(0.10) @db.Decimal(5, 4)
  commissionAmount  Decimal             @default(0) @db.Decimal(15, 2)
  insuranceAmount   Decimal             @default(0) @db.Decimal(15, 2)
  qcOption                QcUpsellOption @default(NONE)
  qcCost                  Decimal        @default(0) @db.Decimal(15, 2)
  serviceProtectionOption String?        @default("NONE") // NONE | BASIC (3%)
  serviceProtectionFeeAmt Decimal        @default(0) @db.Decimal(15, 2)
  totalClient             Decimal        @default(0) @db.Decimal(15, 2)
  currency          String              @default("XAF")
  budgetPlannedXAF  Decimal             @default(0) @db.Decimal(15, 2)
  budgetActualXAF   Decimal             @default(0) @db.Decimal(15, 2)
  fxRatesSnapshot   Json                @default("{}")
  fxImpactXAF       Decimal             @default(0) @db.Decimal(15, 2)
  originCountry     String              @default("CN")
  destinationCity   String              @default("Brazzaville")
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  archivedAt        DateTime?
  notes             String?
  riskLevel         RiskLevel           @default(LOW)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  contact          Contact                @relation(fields: [contactId], references: [id])
  currentQuote     Quote?                 @relation("OrderCurrentQuote", fields: [currentQuoteId], references: [id], onDelete: SetNull)
  owner            User?                  @relation("OrderOwner", fields: [ownerId], references: [id])
  approvedBy       User?                  @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  onboardedBy      User?                  @relation("OrderOnboardedBy", fields: [onboardedById], references: [id])
  collaborators    OrderCollaborator[]
  attachments      OrderAttachment[]
  items            OrderItem[]
  quotes           Quote[]
  timeline         OrderTimeline[]
  sourcingCases    SourcingCase[]
  qcRequests       QCRequest[]
  shipments        Shipment[]
  payments         Payment[]
  tasks            Task[]
  disputes         Dispute[]
  returns          ReturnMerchandise[]
  marginReport     MarginReport?
  invoices         Invoice[]
  approvals        OrderApproval[]
  revisions        OrderRevision[]
  ediTransmissions OrderEdiTransmission[]
  portalTokens     OrderPortalToken[]
  project          Project?               @relation(fields: [projectId], references: [id])
  lead             Lead?                  @relation(fields: [leadId], references: [id])
  qcInspections    QcInspection[]
  demandIntakes    DemandIntake[]
    customsClearance  OrderCustomsClearance?
    warehouseReceipts WarehouseReceipt[]
    warehouseIntakeDrafts WarehouseIntakeDraft[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([orderNumber])
  @@index([ownerId])
  @@index([onboardedById])
  @@index([currentQuoteId])
  @@index([projectId])
  @@index([archivedAt])
  @@index([leadId])
  @@map("orders")
}

enum OrderStatus {
  DEMANDE
  RECHERCHE_PRODUIT
  DEVIS
  PAIEMENT_EN_COURS
  SOURCING
  EN_PRODUCTION
  RECU_ENTREPOT
  QC_EN_COURS
  QC_VALIDE
  EN_TRANSIT
  DEDOUANE
  LIVRE
  CLOTURE
  ANNULE
  LITIGE
}

enum OrderApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model OrderApprovalRule {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  minAmountXAF Decimal  @db.Decimal(15, 2)
  sequence     Int      @default(1)
  requiredRole UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  steps  OrderApproval[]

  @@index([tenantId])
  @@map("order_approval_rules")
}

model OrderApproval {
  id          String         @id @default(cuid())
  orderId     String
  ruleId      String
  status      ApprovalStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime       @default(now())

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rule      OrderApprovalRule @relation(fields: [ruleId], references: [id])
  decidedBy User?             @relation("OrderApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([orderId])
  @@index([ruleId])
  @@map("order_approvals")
}

model OrderRevision {
  id             String   @id @default(cuid())
  orderId        String
  revisionNumber Int
  reason         String?
  snapshot       Json
  createdById    String?
  createdAt      DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation("OrderRevisionCreatedBy", fields: [createdById], references: [id])

  @@unique([orderId, revisionNumber])
  @@index([orderId])
  @@map("order_revisions")
}

enum EdiStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
}

model OrderEdiTransmission {
  id           String    @id @default(cuid())
  orderId      String
  supplierId   String?
  provider     String
  status       EdiStatus @default(PENDING)
  payload      Json
  response     Json?
  errorMessage String?
  sentAt       DateTime?
  ackAt        DateTime?
  createdAt    DateTime  @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([orderId])
  @@index([supplierId])
  @@map("order_edi_transmissions")
}

model OrderPortalToken {
  id        String     @id @default(cuid())
  orderId   String
  token     String     @unique
  role      PortalRole @default(CLIENT)
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_portal_tokens")
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  supplierId   String?
  description  String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(15, 2)
  currency     String   @default("RMB")
  unitPriceXAF Decimal  @default(0) @db.Decimal(15, 2)
  totalXAF     Decimal  @default(0) @db.Decimal(15, 2)
  hsCode       String?
  weight       Decimal? @db.Decimal(10, 2)
  volume       Decimal? @db.Decimal(10, 4)
  notes        String?

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  CatalogProduct? @relation(fields: [productId], references: [id])
  supplier Supplier?       @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@map("order_items")
}

model Quote {
  id               String              @id @default(cuid())
  orderId          String
  version          Int                 @default(1)
  isActive         Boolean             @default(true)
  status           QuoteStatus         @default(DRAFT)
  approvalStatus   QuoteApprovalStatus @default(PENDING)
  approvedById     String?
  approvedAt       DateTime?
  approvalNote     String?
  merchandiseTotal Decimal             @db.Decimal(15, 2)
  logisticsCost    Decimal             @db.Decimal(15, 2)
  commission       Decimal             @db.Decimal(15, 2)
  insuranceCost    Decimal             @default(0) @db.Decimal(15, 2)
  qcOption                QcUpsellOption @default(NONE)
  qcCost                  Decimal        @default(0) @db.Decimal(15, 2)
  serviceProtectionOption String?        @default("NONE") // NONE | BASIC (3%)
  serviceProtectionFeeAmt Decimal        @default(0) @db.Decimal(15, 2)
  cgvAcceptedAt           DateTime?      // Acceptance CGV par le client
  total                   Decimal        @db.Decimal(15, 2)
  currency         String              @default("XAF")
  validUntil       DateTime?
  sentAt           DateTime?
  sentByEmailAt    DateTime?
  sentByEmailTo    String?
  acceptedAt       DateTime?
  signatureToken   String?             @unique
  signedAt         DateTime?
  signedByName     String?
  signedByEmail    String?
  signedByIp       String?
  paymentToken     String?             @unique
  paymentExpiry    DateTime?
  paymentStatus    String?             @default("PENDING")
  paymentMethod    String?
  paidAt           DateTime?
  pricingSnapshot  Json                @default("{}")
  createdAt        DateTime            @default(now())

  order             Order   @relation(fields: [orderId], references: [id])
  currentForOrders  Order[] @relation("OrderCurrentQuote")
  approvedBy        User?   @relation("QuoteApprovedBy", fields: [approvedById], references: [id])

  @@unique([orderId, version])
  @@index([orderId])
  @@index([orderId, isActive])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QcUpsellOption {
  NONE
  VIRTUAL
  PHYSICAL
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  event     String
  fromValue String?
  toValue   String?
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timeline")
}

model OrderCollaborator {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([orderId, userId])
  @@index([userId])
  @@map("order_collaborators")
}

model OrderAttachment {
  id              String   @id @default(cuid())
  orderId         String
  userId          String?
  name            String
  url             String
  type            String   @default("link")
  storageProvider String?
  bucket          String?
  storageKey      String?
  mimeType        String?
  size            Int?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@map("order_attachments")
}

model Dispute {
  id          String        @id @default(cuid())
  orderId     String
  type        DisputeType
  status      DisputeStatus @default(OPEN)
  description String
  resolution  String?
  amount      Decimal?      @db.Decimal(15, 2)
  currency    String        @default("XAF")
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  order   Order               @relation(fields: [orderId], references: [id])
  returns ReturnMerchandise[]

  @@index([orderId])
  @@map("disputes")
}

enum DisputeType {
  QUALITY
  DELAY
  PRICING
  MISSING_ITEMS
  DAMAGE
  OTHER
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ESCALATED
  CLOSED
}

enum ReturnMerchandiseStatus {
  REQUESTED
  APPROVAL_PENDING
  APPROVED
  REJECTED
  IN_TRANSIT_TO_WAREHOUSE
  RECEIVED
  INSPECTED
  RESOLVED
  CLOSED
}

enum ReturnLineCondition {
  UNOPENED
  OPENED
  DAMAGED
  DEFECTIVE
  UNKNOWN
}

model ReturnMerchandise {
  id             String                  @id @default(cuid())
  tenantId       String
  orderId        String
  disputeId      String?
  status         ReturnMerchandiseStatus @default(REQUESTED)
  reason         String
  requestedById  String?
  approvedById   String?
  approvedAt     DateTime?
  receivedAt     DateTime?
  warehouseSite  String?
  trackingNumber String?
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  order       Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispute     Dispute?                @relation(fields: [disputeId], references: [id])
  requestedBy User?                   @relation("ReturnRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?                   @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  lines       ReturnMerchandiseLine[]

  @@index([tenantId, status])
  @@index([orderId])
  @@index([disputeId])
  @@map("return_merchandises")
}

model ReturnMerchandiseLine {
  id          String              @id @default(cuid())
  rmaId       String
  description String
  quantity    Int                 @default(1)
  condition   ReturnLineCondition @default(UNKNOWN)
  notes       String?
  createdAt   DateTime            @default(now())

  rma ReturnMerchandise @relation(fields: [rmaId], references: [id], onDelete: Cascade)

  @@index([rmaId])
  @@map("return_merchandise_lines")
}

// ============================================================
// C2. DOUANES & PROTECTION (lié aux commandes)
// ============================================================

enum CustomsClearanceStatus {
  PENDING
  IN_PROGRESS
  CLEARED
  HOLD
  REJECTED
}

model OrderCustomsClearance {
  id                String                 @id @default(cuid())
  orderId           String                 @unique
  brokerContactId   String?
  incoterm          String?                // EXW | FOB | CIF | DAP | DDP
  dutiesAmount      Decimal?               @db.Decimal(15, 2)
  feesAmount        Decimal?               @db.Decimal(15, 2)
  currency          String                 @default("XAF")
  status            CustomsClearanceStatus @default(PENDING)
  declarationRef    String?
