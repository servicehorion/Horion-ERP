// ============================================================
// PILOTAGE OS — Strategic Decisions & Execution
// ============================================================

enum StrategicDecisionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StrategicDecisionStatus {
  DRAFT
  ACTIVE
  EXECUTING
  COMPLETED
  CANCELLED
}

enum StrategicDecisionHorizon {
  MONTH
  QUARTER
  YEAR
}

enum DecisionActionType {
  CREATE_PROJECT
  CREATE_TASKS
  UPDATE_POLICY
  REALLOCATE_RESOURCES
  ACTIVATE_DECISION
  EVALUATE_RULES
}

enum DecisionActionStatus {
  PENDING
  EXECUTED
  FAILED
}

enum StrategicRiskCategory {
  FINANCIAL
  LOGISTICS
  SUPPLIER
  QUALITY
  CRM
  OPERATIONAL
}

enum StrategicRiskStatus {
  OPEN
  MITIGATING
  ESCALATED
  RESOLVED
  ACCEPTED
}

enum RiskTimelineType {
  DETECTED
  MITIGATION
  ESCALATED
  NOTE
  RESOLVED
  OWNER_CHANGED
}

model StrategicDecision {
  id                  String                    @id @default(cuid())
  tenantId            String
  title               String
  description         String?
  objective           String?
  targetMetric        String?
  targetValue         Float?
  targetUnit          String?
  riskLevel           RiskLevel?
  priority            StrategicDecisionPriority @default(MEDIUM)
  status              StrategicDecisionStatus   @default(DRAFT)
  horizon             StrategicDecisionHorizon  @default(QUARTER)
  impactAreas         Json                      @default("[]")
  executionPlan       Json                      @default("{}")
  activationRules     Json                      @default("[]")
  executionTemplateId String?
  ownerId             String?
  executedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  owner             User?                      @relation("DecisionOwner", fields: [ownerId], references: [id])
  executionTemplate DecisionExecutionTemplate? @relation(fields: [executionTemplateId], references: [id])
  actions           DecisionAction[]

  @@index([tenantId, status])
  @@index([ownerId])
  @@map("strategic_decisions")
}

model DecisionAction {
  id         String               @id @default(cuid())
  decisionId String
  type       DecisionActionType
  status     DecisionActionStatus @default(PENDING)
  payload    Json                 @default("{}")
  error      String?
  executedAt DateTime?
  createdAt  DateTime             @default(now())

  decision StrategicDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([status])
  @@map("decision_actions")
}

model DecisionExecutionTemplate {
  id                 String                    @id @default(cuid())
  tenantId           String
  createdById        String?
  name               String
  description        String?
  impactAreas        String[]                  @default([])
  defaultPriority    StrategicDecisionPriority @default(MEDIUM)
  defaultHorizon     StrategicDecisionHorizon  @default(QUARTER)
  projectName        String?
  projectDescription String?
  tasks              Json                      @default("[]")
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  createdBy User?               @relation(fields: [createdById], references: [id])
  decisions StrategicDecision[]

  @@index([tenantId, isActive])
  @@map("decision_execution_templates")
}

model StrategicRisk {
  id               String                @id @default(cuid())
  tenantId         String
  fingerprint      String
  title            String
  description      String?
  category         StrategicRiskCategory
  severity         RiskLevel             @default(MEDIUM)
  status           StrategicRiskStatus   @default(OPEN)
  sourceMetric     String?
  sourceValue      Float?
  thresholdValue   Float?
  trend            String?
  impactAreas      String[]              @default([])
  linkedHref       String?
  linkedEntityType String?
  linkedEntityId   String?
  ownerId          String?
  mitigationPlan   Json                  @default("[]")
  escalationRules  Json                  @default("[]")
  lastDetectedAt   DateTime              @default(now())
  escalatedAt      DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  owner   User?                 @relation("StrategicRiskOwner", fields: [ownerId], references: [id])
  entries RiskMitigationEntry[]

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, severity])
  @@index([tenantId, category])
  @@index([ownerId])
  @@map("strategic_risks")
}

model RiskMitigationEntry {
  id          String           @id @default(cuid())
  riskId      String
  type        RiskTimelineType @default(NOTE)
  title       String
  detail      String?
  meta        Json             @default("{}")
  createdById String?
  createdAt   DateTime         @default(now())

  risk      StrategicRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("RiskMitigationAuthor", fields: [createdById], references: [id])

  @@index([riskId, createdAt])
  @@map("risk_mitigation_entries")
}

