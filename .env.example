# Horion ERP - Variables d'environnement

# Database (Supabase PostgreSQL)
# URL directe pour migrations/seeds
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-GCP-IP]:5432/postgres"

# URL avec pooling pour l'app (PgBouncer port 6543)
DATABASE_URL_POOLING="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-GCP-IP]:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase (optionnel - si vous utilisez Auth/Storage/Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-DOMAIN]"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_URL="https://[YOUR-SUPABASE-DOMAIN]"
SUPABASE_STORAGE_BUCKET="horion-documents"
SUPABASE_STORAGE_PUBLIC="false"

# NextAuth
NEXTAUTH_SECRET="horion-erp-dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Horion ERP"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PUBLIC_QUOTE_SITE_BASE_URL="http://localhost:3000/pay"
QUOTE_ASSISTANT_APPROVAL_THRESHOLD_XAF="100000"
QUOTE_MANAGER_APPROVAL_THRESHOLD_XAF="500000"
NEXT_PUBLIC_CONTACT_EMAIL="servicehorion@gmail.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="242064600831"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+242 06 460 08 31"
NEXT_PUBLIC_BRAND_NAME="Horion"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Horion ERP <noreply@horion.cg>"
EMAIL_PROVIDER="resend"

# Cron (Vercel)
CRON_SECRET="change-me"

# Payments
PAYMENT_GATEWAY_PROVIDER="AGGREGATOR"
PAYMENT_WEBHOOK_SECRET="change-me-payment-webhook"
PAYMENT_GATEWAY_CHECKOUT_BASE_URL=""
UPAY_CHECKOUT_BASE_URL=""
UPAY_API_URL=""
UPAY_PUBLIC_KEY=""
UPAY_SECRET_KEY=""
WIRE_TRANSFER_EXPIRY_HOURS="72"
CASH_DEPOSIT_EXPIRY_HOURS="48"

# Sentry
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Upstash rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Logistics webhooks
LOGISTICS_WEBHOOK_SECRET="change-me"
LOGISTICS_SLA_WEBHOOK_SECRET="change-me"
TRACKING_WEBHOOK_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# EDI (N8N / fournisseurs)
EDI_WEBHOOK_URL=""
EDI_WEBHOOK_TOKEN=""
# Provider specific (optional)
# EDI_WEBHOOK_URL_CN_EDI=""
# EDI_WEBHOOK_TOKEN_CN_EDI=""

# Order approval SLA (hours)
ORDER_APPROVAL_SLA_HOURS="48"

# Carrier tracking (AfterShip)
AFTERSHIP_API_KEY=""
# Carrier tracking providers (optional)
MSC_API_KEY=""
CMA_CGM_API_KEY=""
COSCO_API_KEY=""

# Bank webhook
BANK_WEBHOOK_SECRET=""
# Bank API (Open Banking / BGFI / Ecobank)
BANK_API_URL=""
# BANK_API_URL_BGFI=""
# BANK_API_URL_ECOBANK=""

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="change-me-whatsapp-verify-token"
WHATSAPP_APP_SECRET=""

# WAHA (self-hosted WhatsApp HTTP API — alternative à Meta Cloud API)
# https://waha.devlike.pro/
WAHA_BASE_URL="http://localhost:3001"
WAHA_API_KEY="your_waha_api_key"

# Anthropic (IA — génération contenu, CRM Next Best Action, logistique)
ANTHROPIC_API_KEY=""
HORION_PARTNER_SECRET=""

# Production URLs (commenté en dev)
# NEXTAUTH_URL="https://erp.horion.cg"
# NEXT_PUBLIC_APP_URL="https://erp.horion.cg"

# Agent API
AGENT_REGISTRY_JSON=""
# Alternative: base64-encoded JSON
AGENT_REGISTRY_BASE64=""

# Email webhook (Resend)
EMAIL_WEBHOOK_SECRET="change-me"

# Upload limits
UPLOAD_MAX_MB="20"
UPLOAD_MAX_MB_IMAGE="5"
ALLOW_PUBLIC_UPLOADS="false"

# Sourcing SLA webhook
SOURCING_SLA_WEBHOOK_SECRET="change-me"

# Antivirus scan (optional)
FILE_SCAN_WEBHOOK_URL=""
FILE_SCAN_WEBHOOK_TOKEN=""
WHATSAPP_WEBHOOK_SECRET=""
