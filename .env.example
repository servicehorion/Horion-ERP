# Horion ERP - Variables d'environnement

# Database (Supabase PostgreSQL)
# URL directe pour migrations/seeds
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-GCP-IP]:5432/postgres"

# URL avec pooling pour l'app (PgBouncer port 6543)
DATABASE_URL_POOLING="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-GCP-IP]:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase (optionnel - si vous utilisez Auth/Storage/Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-DOMAIN]"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_URL="https://[YOUR-SUPABASE-DOMAIN]"
SUPABASE_STORAGE_BUCKET="horion-documents"
SUPABASE_STORAGE_PUBLIC="false"

# NextAuth v5 — AUTH_SECRET est le nom privilégié (NEXTAUTH_SECRET accepté aussi)
AUTH_SECRET="changez-moi-32-chars-minimum-random"
NEXTAUTH_SECRET="changez-moi-32-chars-minimum-random"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Horion ERP"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PUBLIC_QUOTE_SITE_BASE_URL="http://localhost:3000/pay"
QUOTE_ASSISTANT_APPROVAL_THRESHOLD_XAF="2000000"
QUOTE_MANAGER_APPROVAL_THRESHOLD_XAF="5000000"
QUOTE_CEO_APPROVAL_THRESHOLD_XAF="20000000"
NEXT_PUBLIC_CONTACT_EMAIL="servicehorion@gmail.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="242064600831"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+242 06 460 08 31"
NEXT_PUBLIC_BRAND_NAME="Horion"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Horion ERP <noreply@horion.cg>"
EMAIL_PROVIDER="resend"

# Cron (Vercel)
CRON_SECRET="change-me"
FINANCE_SYNC_TTL_MS="15000"

