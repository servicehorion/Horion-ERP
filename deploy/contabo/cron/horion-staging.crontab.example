SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# WARNING
# N'installe ce crontab que si le staging utilise une base de donnees
# et des integrations isolees de la production.

HORION_DOMAIN=https://staging.horion.tech
CRON_SECRET=CHANGE_ME_CRON_SECRET

# Horion ERP staging cron jobs

*/15 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/sla-check" >> /var/log/horion-crons/staging-sla-check.log 2>&1
*/15 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/pawapay-status" >> /var/log/horion-crons/staging-pawapay-status.log 2>&1
*/30 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/strategic-risk" >> /var/log/horion-crons/staging-strategic-risk.log 2>&1
*/30 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/strategic-decisions" >> /var/log/horion-crons/staging-strategic-decisions.log 2>&1
*/30 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/nurturing-step" >> /var/log/horion-crons/staging-nurturing-step.log 2>&1
*/30 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/finance-approval-escalation" >> /var/log/horion-crons/staging-finance-approval-escalation.log 2>&1
*/30 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/sourcing-sla-check" >> /var/log/horion-crons/staging-sourcing-sla-check.log 2>&1
0 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/lead-scoring" >> /var/log/horion-crons/staging-lead-scoring.log 2>&1
0 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/expire-payments" >> /var/log/horion-crons/staging-expire-payments.log 2>&1
0 * * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/recurring-tasks" >> /var/log/horion-crons/staging-recurring-tasks.log 2>&1
0 */4 * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/treasury-balance-alerts" >> /var/log/horion-crons/staging-treasury-balance-alerts.log 2>&1
0 */6 * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/fx-rates" >> /var/log/horion-crons/staging-fx-rates.log 2>&1
0 2 * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/intelligence-refresh" >> /var/log/horion-crons/staging-intelligence-refresh.log 2>&1
0 3 * * * /usr/bin/curl -fsS -X POST -H "x-horion-secret: ${CRON_SECRET}" "${HORION_DOMAIN}/api/cron/assistant-knowledge-sync" >> /var/log/horion-crons/staging-assistant-knowledge-sync.log 2>&1
